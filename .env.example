# Next.js
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Application Security
SCHEDULER_API_SECRET=your-secure-scheduler-secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Brave Search API
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# Rate limiting in milliseconds (default: 1000ms = 1 request per second)
BRAVE_RATE_LIMIT_MS=1000

# Alert Processing Configuration
# Maximum number of search results to send to AI (default: 3)
MAX_AI_RESULTS=3
# Cache expiry in milliseconds (default: 3600000ms = 1 hour)
CACHE_EXPIRY_MS=3600000

# Anthropic API (for Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Use batch processing instead of individual requests (default: false)
ANTHROPIC_USE_BATCH=true
# Model to use for AI processing
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# Batch size threshold - process batch when this many requests are queued
ANTHROPIC_BATCH_SIZE=20
# Maximum time to wait before processing a batch (in milliseconds)
ANTHROPIC_BATCH_WAIT_MS=60000

# Stripe (for payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Listmonk Email Service
LISTMONK_BASE_URL=http://localhost:9000
LISTMONK_USERNAME=listmonk
LISTMONK_PASSWORD=listmonk
LISTMONK_ALERT_LIST_ID=1 